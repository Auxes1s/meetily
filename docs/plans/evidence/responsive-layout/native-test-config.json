{
  "productName": "Meetily Responsive Test",
  "identifier": "com.meetily.responsive.test",
  "app": {
    "windows": [
      {
        "title": "Meetily Responsive Test",
        "width": 1100,
        "height": 700
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "responsive",
          "windows": [
            "main"
          ],
          "permissions": [
            "fs:default",
            "fs:allow-read-file",
            "fs:read-all",
            "fs:write-all",
            "fs:allow-app-read",
            "fs:allow-app-write",
            "fs:allow-download-write",
            "fs:allow-download-read",
            "fs:scope-download",
            "core:path:default",
            "core:event:default",
            "core:window:default",
            "core:app:default",
            "core:resources:default",
            "core:menu:default",
            "core:tray:default",
            "core:window:allow-set-title",
            "store:default",
            "notification:default",
            "notification:allow-is-permission-granted",
            "updater:default",
            "process:default",
            {
              "identifier": "fs:scope",
              "allow": [
                {
                  "path": "$APPDATA/*"
                }
              ]
            },
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-set-focus"
          ]
        }
      ]
    }
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  },
  "build": {
    "beforeBuildCommand": ""
  }
}
