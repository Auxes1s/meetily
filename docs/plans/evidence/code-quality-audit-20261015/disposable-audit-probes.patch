+#[tokio::test]
+async fn audit_probe_old_timestamp_blocks_save_after_append() {
+    let (_dir, db) = fixture().await;
+    let mut first = input(0, "meetily-note://audit-marker");
+    first.links.push(NoteLink { id:"audit-marker".into(), block_id:"block".into(), recording_session_id:"session-a".into(), recording_offset:2.0, transcript_id:None });
+    notes_commands::save(db.pool(), first).await.unwrap();
+    let segments=[crate::api::TranscriptSegment { audio_source:None,id:"ignored".into(),text:"First recording".into(),timestamp:"00:02".into(),audio_start_time:Some(1.),audio_end_time:Some(3.),duration:Some(2.),sequence_id:Some(1) }];
+    TranscriptsRepository::save_transcript(db.pool(),"Original",&segments,None,Some("meeting-a".into()),Some("session-a".into())).await.unwrap();
+    super::recording_sessions::begin(db.pool(),"meeting-a","session-b").await.unwrap();
+    super::recording_sessions::mark_live(db.pool(),"session-b",None).await.unwrap();
+    let mut later=input(1,"Edited notes meetily-note://audit-marker");
+    later.links.push(NoteLink { id:"audit-marker".into(),block_id:"block".into(),recording_session_id:"session-a".into(),recording_offset:2.0,transcript_id:None });
+    let error=notes_commands::save(db.pool(),later).await.unwrap_err();
+    assert_eq!(error.code,"invalid_document");
+    let saved=notes_commands::load(db.pool(),"meeting-a").await.unwrap().unwrap();
+    assert_eq!(saved.revision,1);
+    assert_eq!(saved.links[0].recording_session_id,"session-a");
+    println!("OBSERVED: appending session-b makes valid session-a timestamp reject later note save; revision stays 1");
+    db.cleanup().await.unwrap();
+}
