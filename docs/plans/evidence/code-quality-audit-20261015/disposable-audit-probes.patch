+ #[tokio::test]
+ async fn audit_probe_stop_database_failure_loses_manager_with_recording_flag_set() {
+  let directory=tempfile::tempdir().unwrap();
+  let db=crate::database::manager::DatabaseManager::new(directory.path().join("audit.sqlite").to_str().unwrap(),"missing.db").await.unwrap();
+  sqlx::query("INSERT INTO meetings(id,title,created_at,updated_at,status,recording_session_id) VALUES('audit-meeting','Audit','2026-10-15','2026-10-15','recording','audit-session')").execute(db.pool()).await.unwrap();
+  sqlx::query("INSERT INTO recording_sessions(id,meeting_id,ordinal,status,created_at) VALUES('audit-session','audit-meeting',1,'recording','2026-10-15')").execute(db.pool()).await.unwrap();
+  sqlx::query("CREATE TRIGGER audit_fail_stop BEFORE UPDATE ON recording_sessions BEGIN SELECT RAISE(ABORT,'audit forced write failure'); END").execute(db.pool()).await.unwrap();
+  let app=tauri::test::mock_app(); app.manage(crate::state::AppState{db_manager:db.clone()});
+  let mut manager=RecordingManager::new();manager.set_identity(Some("audit-meeting".into()),Some("audit-session".into()));
+  *LAST_SESSION_IDENTITY.lock().unwrap()=(Some("audit-meeting".into()),Some("audit-session".into()));
+  *RECORDING_MANAGER.lock().unwrap()=Some(manager);IS_RECORDING.store(true,Ordering::SeqCst);
+  let error=stop_recording(app.handle().clone(),RecordingArgs{save_path:String::new(),recording_session_id:Some("audit-session".into())}).await.unwrap_err();
+  assert!(error.contains("audit forced write failure"));
+  assert!(RECORDING_MANAGER.lock().unwrap().is_none());
+  assert!(IS_RECORDING.load(Ordering::SeqCst));
+  assert!(!IS_RECORDING_STOPPING.load(Ordering::SeqCst));
+  assert_eq!(get_recording_state().await["phase"],"recording");
+  println!("OBSERVED: failed Stop DB update consumes the manager but status still reports recording");
+  IS_RECORDING.store(false,Ordering::SeqCst);*LAST_SESSION_IDENTITY.lock().unwrap()=(None,None);
+  db.cleanup().await.unwrap();
+ }
