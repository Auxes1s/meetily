+#[cfg(test)]
+mod audit_path_probes {
+ use super::*;
+ #[tokio::test]
+ async fn audit_probe_apostrophe_recording_root_breaks_finalization() {
+  let directory=tempfile::tempdir().unwrap();let folder=directory.path().join("Marc's recordings");
+  std::fs::create_dir_all(folder.join(".checkpoints")).unwrap();
+  let mut saver=IncrementalAudioSaver::new(folder.clone(),48000).unwrap();
+  saver.add_chunk(AudioChunk{data:vec![0.1;4800],sample_rate:48000,timestamp:0.,chunk_id:0,device_type:super::super::recording_state::DeviceType::Microphone}).unwrap();
+  let error=saver.finalize().await.unwrap_err();
+  assert!(error.to_string().contains("FFmpeg concat failed"));
+  assert!(folder.join(".checkpoints/audio_chunk_000.mp4").is_file());
+  println!("OBSERVED: apostrophe in valid recording root prevents FFmpeg concat; encoded checkpoint remains");
+ }
